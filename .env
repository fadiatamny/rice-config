# rice-config environment
#
# This file is loaded by ai.sh before it installs or configures AI tools. It is
# shell syntax: keep values quoted, and leave optional values empty to use the
# installer's automatic/default behavior. Never put a real secret in this
# tracked file.

# ─── Ollama ──────────────────────────────────────────────────────────────────
# Optional persistent model storage. Leave empty to use the installer's
# automatic default; Ollama's systemd service receives the resolved value on Linux.
OLLAMA_MODELS_DIR=""
# Native Ollama override; normally leave empty and use OLLAMA_MODELS_DIR above.
OLLAMA_MODELS=""
# Space-separated model tags pulled when the AI installer is run.
OLLAMA_MODEL_TAGS="qwen3.8:27b qwen3.5:9b gemma4:e4b"
