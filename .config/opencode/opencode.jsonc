{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "compaction": {
    // Compact only when explicitly requested at a user-defined milestone.
    "auto": false,
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git add *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git cherry-pick *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny",
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow",
    },
  ],
  "providers": {
    "ollama": {
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
      },
    },
  },
  // OpenCode discovers locally installed Ollama models automatically.
  // Keep model choice at the session or agent level until a stable library is chosen.
  "skills": ["~/.ai-development/skills"],
  "websearch": {
    // Select any connected OpenCode web provider and fail over on rate limits.
    "provider": "random",
  },
  "mcp": {
    "servers": {
      "ddg-search": {
        "type": "local",
        "command": ["uvx", "duckduckgo-mcp-server"],
        "disabled": false,
      },
    },
  },
}
