{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "compaction": {
    // Compact only when explicitly requested at a user-defined milestone.
    "auto": false,
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git add *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git commit *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git cherry-pick *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny",
    },
    // Safe local inspection commands. All other shell commands still ask.
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git branch *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git show *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git rev-parse *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git ls-files *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git remote -v",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "which *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "command -v *",
      "effect": "allow",
    },
    // Explicit patterns avoid automatically allowing environment-file reads.
    { "action": "shell", "resource": "cat *.md", "effect": "allow" },
    { "action": "shell", "resource": "cat *.txt", "effect": "allow" },
    { "action": "shell", "resource": "cat *.json", "effect": "allow" },
    { "action": "shell", "resource": "cat *.jsonc", "effect": "allow" },
    { "action": "shell", "resource": "cat *.yaml", "effect": "allow" },
    { "action": "shell", "resource": "cat *.yml", "effect": "allow" },
    { "action": "shell", "resource": "cat *.toml", "effect": "allow" },
    { "action": "shell", "resource": "cat *.ini", "effect": "allow" },
    { "action": "shell", "resource": "head *.md", "effect": "allow" },
    { "action": "shell", "resource": "head *.txt", "effect": "allow" },
    { "action": "shell", "resource": "head *.json", "effect": "allow" },
    { "action": "shell", "resource": "head *.jsonc", "effect": "allow" },
    { "action": "shell", "resource": "head *.yaml", "effect": "allow" },
    { "action": "shell", "resource": "head *.yml", "effect": "allow" },
    { "action": "shell", "resource": "head *.toml", "effect": "allow" },
    { "action": "shell", "resource": "head *.ini", "effect": "allow" },
    { "action": "shell", "resource": "tail *.md", "effect": "allow" },
    { "action": "shell", "resource": "tail *.txt", "effect": "allow" },
    { "action": "shell", "resource": "tail *.json", "effect": "allow" },
    { "action": "shell", "resource": "tail *.jsonc", "effect": "allow" },
    { "action": "shell", "resource": "tail *.yaml", "effect": "allow" },
    { "action": "shell", "resource": "tail *.yml", "effect": "allow" },
    { "action": "shell", "resource": "tail *.toml", "effect": "allow" },
    { "action": "shell", "resource": "tail *.ini", "effect": "allow" },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow",
    },
  ],
  "providers": {
    "ollama": {
      "name": "Ollama (local)",
      "settings": {
        "baseURL": "http://localhost:11434/v1",
      },
    },
  },
  // OpenCode discovers additional locally installed Ollama models automatically.
  "skills": ["~/.ai-development/skills"],
  "websearch": {
    // Select any connected OpenCode web provider and fail over on rate limits.
    "provider": "random",
  },
  "mcp": {
    "servers": {
      "ddg-search": {
        "type": "local",
        "command": ["uvx", "duckduckgo-mcp-server"],
        "disabled": false,
      },
    },
  },
}
