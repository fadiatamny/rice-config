{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:14b": {
          "name": "Qwen 2.5 Coder"
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5"
        }
      }
    }
  },
  "plugin": [],
  "skills": {
    "paths": ["~/.config/opencode/skills"]
  },
  "mcp": {
    "ddg-search": {
      "type": "local",
      "command": ["uvx", "duckduckgo-mcp-server"],
      "enabled": true
    }
  }
}
